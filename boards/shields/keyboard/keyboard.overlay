#include <dt-bindings/zmk/matrix_transform.h>
#include "keyboard-layouts.dtsi"  /* PRD §11 step 10: ZMK Studio physical layout */

/* PRD §11 step 2: real 5x14 matrix.
 * Rows are nRF GPIO inputs; columns are MCP23017 outputs driven over I2C.
 * Diode direction is col2row (verified from the PCB: each diode's cathode sits
 * on the ROW net, anode on the switch/column side -> current flows col->row).
 * Keeping the row inputs on the nRF lets GPIO sense wake the MCU from deep
 * sleep; the MCP23017 INT line is not wired to the nRF, so the expander must
 * stay on the output (strobe) side.
 *
 * PRD §11 step 5: EC11E encoder added.
 * - Rotation sensor: alps,ec11 on P0.17 (A) / P0.08 (B), steps=60
 * - Push button:     zmk,kscan-gpio-direct on P0.20 (active-low + pull-up)
 * - The matrix (rows 0-4) and push button (row 5) are merged via
 *   zmk,kscan-composite; the composite becomes the chosen zmk,kscan.
 * - Matrix transform gains a 69th key: RC(5,0) = encoder push.           */

/* ── UART0 pinctrl override ──────────────────────────────────────────────────
 * The board default uart0_default pinctrl claims P0.08 (UART_RX) and P0.06
 * (UART_TX) — P0.08 is our encoder B pin and P0.17 is our encoder A pin.
 * UART0 is disabled (no status="okay"), but its pinctrl state is still
 * registered and can prevent GPIO interrupt configuration on those pins.
 * Remap to internally unused pins so the encoder's GPIO interrupts work.    */
&uart0_default {
    group1 {
        psels = <NRF_PSEL(UART_RX, 0, 25)>;   /* dummy — not routed */
        bias-pull-up;
    };
    group2 {
        psels = <NRF_PSEL(UART_TX, 0, 25)>;   /* dummy — not routed */
    };
};

&uart0_sleep {
    group1 {
        psels = <NRF_PSEL(UART_RX, 0, 25)>,
                <NRF_PSEL(UART_TX, 0, 25)>;
        low-power-enable;
    };
};

/* ── SPI1 pinctrl override ────────────────────────────────────────────────────
 * The board's default spi1 pinctrl (SCK=P1.13, MOSI=P0.10, MISO=P1.11) uses
 * pins that are all occupied in this design (P1.13=ROW5, P0.10=nice!view SCK,
 * P1.11=nice!view MOSI). Override to our actual PCB wiring:
 *   MOSI = P1.11 (pad 22)   SCK = P0.10 (pad 23)   CS = P0.09 (pad 24, GPIO)
 * MISO is not connected (display is write-only). P0.25 is an internal nRF pin
 * not routed to any nice!nano pad; it is used here as a harmless dummy MISO so
 * the driver is satisfied without leaving the field empty.                   */
&spi1_default {
    group1 {
        psels = <NRF_PSEL(SPIM_MOSI, 1, 11)>,
                <NRF_PSEL(SPIM_SCK,  0, 10)>,
                <NRF_PSEL(SPIM_MISO, 0, 25)>;
    };
};

&spi1_sleep {
    group1 {
        psels = <NRF_PSEL(SPIM_MOSI, 1, 11)>,
                <NRF_PSEL(SPIM_SCK,  0, 10)>,
                <NRF_PSEL(SPIM_MISO, 0, 25)>;
        low-power-enable;
    };
};

/* Expose spi1 under the nice_view_spi alias that the nice_view shield requires.
 * Our keyboard.zmk.yml exposes [nice_view_header] so no adapter shield is needed.
 * CS is managed by the SPI controller via gpio: P0.09 (pad 24), active-high.  */
nice_view_spi: &spi1 {
    status = "okay";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
};

/* ── I2C0 pinctrl override ───────────────────────────────────────────────────
 * Override the board's default I2C0 pins (P0.17/P0.20) so the encoder can use
 * those pins later. Hardware routes I2C to P1.07 (SDA) / P1.02 (SCL). No
 * external pull-ups on the bus, so enable the nRF internal ones. These extend
 * the existing board pinctrl states by label, replacing their psels.         */
&i2c0_default {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 1, 7)>, <NRF_PSEL(TWIM_SCL, 1, 2)>;
        bias-pull-up;
    };
};

&i2c0_sleep {
    group1 {
        psels = <NRF_PSEL(TWIM_SDA, 1, 7)>, <NRF_PSEL(TWIM_SCL, 1, 2)>;
        low-power-enable;
    };
};

&i2c0 {
    status = "okay";
    /* Fast mode, 400 kHz — measured on this board, not assumed.
     *
     * A runtime sweep (debug/i2c_scan_timing.c, since removed) compared both
     * speeds on this hardware and found 400 kHz completely clean: 0 write
     * errors, 0 read errors and 0 mismatches across 300 write/read-back round
     * trips, identical to 100 kHz. Per-port-write cost fell 513 us -> 196 us,
     * taking a full 14-column scan from 14.36 ms to 5.49 ms (2.6x).
     *
     * That is worth recording because fast mode is technically OUT OF SPEC
     * here: the board has no external I2C pull-ups (the BOM contains zero
     * resistors; PRD §2.3 states it outright), so SDA/SCL rise on the nRF's
     * internal ~13k pull-ups at roughly 470 ns against the 300 ns fast mode
     * requires. The short trace evidently carries it anyway, but the margin is
     * empirical, not guaranteed by the numbers. If this board ever misbehaves
     * on the bus, drop to <250000> (in spec) before suspecting anything else;
     * fitting 4.7k pull-ups from C1 pad 1 to U2 pads 12/13 would restore
     * proper margin at 400 kHz.
     *
     * Note the gain is bounded well below the 4x clock ratio: of the 513 us at
     * 100 kHz only ~380 us is bus time, the rest being fixed TWIM setup,
     * semaphore and context-switch overhead per transaction, which does not
     * scale with clock. At 400 kHz that fixed cost is over half of each
     * transaction. */
    clock-frequency = <400000>;

    mcp23017: mcp23017@20 {
        compatible = "microchip,mcp230xx";
        status = "okay";
        gpio-controller;
        reg = <0x20>;
        #gpio-cells = <2>;
        ngpios = <16>;
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        /* Step 10: use physical-layout (which carries the transform) so
         * ZMK Studio can expose the key map for live editing.             */
        zmk,physical-layout = &default_layout;
    };

    /* ── Key matrix (rows 0-4 of the composite) ──────────────────────────── */

    /* Renamed from kscan0; now a sub-scanner inside the composite.
     * wakeup-source stays here so the composite can propagate it to this
     * child and the nRF row GPIOs can still trigger deep-sleep wake. */
    kscan_matrix: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        /* ── Scan timing ──────────────────────────────────────────────────────
         * These were previously unset, inheriting the binding defaults, which
         * is what caused rapid double-taps to merge into single keystrokes.
         *
         * The driver does NOT measure elapsed time. It feeds the debouncer the
         * configured debounce-scan-period-ms as its elapsed_ms
         * (kscan_gpio_matrix.c:247), so thresholds are really counted in whole
         * scans:
         *
         *     scans_to_latch  = ceil(threshold / scan-period) + 1   (0 -> 1)
         *     real_debounce   = scans_to_latch x actual_scan_duration
         *
         * A full 14-column scan is 28 I2C transactions and measures 5.49 ms at
         * 400 kHz. Defaults (scan-period 1, threshold 4) meant 5 scans, i.e.
         * ~72 ms of real debounce in each direction at the old 100 kHz scan
         * rate -- longer than the gap between two fast taps, so the release was
         * never observed and the pair collapsed into one keystroke. These
         * values give 2 scans, about 11 ms, a 6.5x reduction.                */

        /* At or above the measured 5.49 ms scan. This is load-bearing beyond
         * debounce scaling: read_continue() advances a scan_time counter by
         * this amount and reschedules with K_TIMEOUT_ABS_MS, so setting it
         * below the true scan duration makes the deadline fall permanently
         * into the past, the work item re-fire immediately, and the board scan
         * back-to-back at 100% bus duty forever. That is what it was doing. */
        debounce-scan-period-ms = <6>;

        /* ceil(1/6)+1 = 2 scans ~= 11 ms. Any threshold from 1 to 6 collapses
         * to the same 2 scans at this scan period; 1 states the intent most
         * plainly. Two scans means the level must hold across two samples
         * 6 ms apart, comfortably longer than MX bounce (1-5 ms), while
         * staying far below the ~40-90 ms gap of a fast double-tap.          */
        debounce-press-ms   = <1>;
        debounce-release-ms = <1>;

        /* Gap after the last key releases before scanning resumes. Must also
         * stay at or above the scan duration or the drift above returns, so
         * the usable range here is ~6 (91% duty) to ~15 (37% duty).
         *
         * Less dangerous than it looks, which is what frees it up as the
         * battery knob: a tap is only lost if the whole press AND release fit
         * inside this window, and human contact time is ~30-60 ms. The
         * constraint that was actually being violated was the debounce window
         * versus the inter-tap gap, handled above. 10 ms gives ~55% bus duty,
         * already better than the ~100% the board was running at.            */
        poll-period-ms = <10>;

        /* Outputs (strobe), on the MCP23017. GPA0..7 = 0..7, GPB0..7 = 8..15. */
        col-gpios
            = <&mcp23017 15 GPIO_ACTIVE_HIGH>   /* COL1  GPB7 */
            , <&mcp23017 14 GPIO_ACTIVE_HIGH>   /* COL2  GPB6 */
            , <&mcp23017 13 GPIO_ACTIVE_HIGH>   /* COL3  GPB5 */
            , <&mcp23017 12 GPIO_ACTIVE_HIGH>   /* COL4  GPB4 */
            , <&mcp23017 11 GPIO_ACTIVE_HIGH>   /* COL5  GPB3 */
            , <&mcp23017 10 GPIO_ACTIVE_HIGH>   /* COL6  GPB2 */
            , <&mcp23017  9 GPIO_ACTIVE_HIGH>   /* COL7  GPB1 */
            , <&mcp23017  8 GPIO_ACTIVE_HIGH>   /* COL8  GPB0 */
            , <&mcp23017  5 GPIO_ACTIVE_HIGH>   /* COL9  GPA5 (swapped: PCB routes COL9-10 to GPA5-6) */
            , <&mcp23017  6 GPIO_ACTIVE_HIGH>   /* COL10 GPA6 */
            , <&mcp23017  7 GPIO_ACTIVE_HIGH>   /* COL11 GPA7 (swapped: PCB routes COL11 to GPA7) */
            , <&mcp23017  4 GPIO_ACTIVE_HIGH>   /* COL12 GPA4 */
            , <&mcp23017  3 GPIO_ACTIVE_HIGH>   /* COL13 GPA3 (swapped: PCB routes COL13 to GPA3) */
            , <&mcp23017  2 GPIO_ACTIVE_HIGH>   /* COL14 GPA2 */
            ;

        /* Inputs (sense), on the nRF. */
        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW1 P0.31 */
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW2 P0.22 */
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW3 P0.02 */
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW4 P1.15 */
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW5 P1.13 */
            ;
    };

    /* ── Encoder push button (row 5 of the composite) ────────────────────── */

    /* EC11E push switch S1 on P0.20; S2 tied to GND → active-low. */
    kscan_encoder_btn: kscan_encoder_btn {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios = <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        /* PRD v2 §1: deep-sleep wake source. P0.20 is a native nRF GPIO with
         * no I2C expander in the path, so it is interrupt-capable and can wake
         * the SoC from deep sleep — unlike the matrix, whose columns run
         * through the MCP23017 and force polled scanning. Zephyr's PM model
         * requires wakeup-source on the specific wake-capable device; the
         * parent composite declaring it does not confer it on this child.
         * Press wakes; rotation does not (the encoder node is separate). */
        wakeup-source;
    };

    /* ── Composite kscan (chosen zmk,kscan) ──────────────────────────────── */

    /* Merges the 5-row matrix and the 1-key encoder push button.
     * row-offset=5 places the push button at RC(5,0) in the transform.
     * wakeup-source here enables PM wakeup propagation to capable children. */
    kscan0: kscan0 {
        compatible = "zmk,kscan-composite";
        rows = <6>;
        columns = <14>;
        wakeup-source;

        matrix {
            kscan = <&kscan_matrix>;
        };

        encoder_btn {
            kscan = <&kscan_encoder_btn>;
            row-offset = <5>;
        };
    };

    /* ── EC11E rotary encoder ─────────────────────────────────────────────── */

    /* PRD §2.6: A=P0.17 (pad 5), B=P0.08 (pad 2), steps=60 (60 quadrature
     * transitions per revolution; 30 detents × 2 transitions/detent).
     * Internal pull-ups required — no external pull-ups on PCB.
     * triggers-per-rotation=30 in the sensors node → one action per detent. */
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <30>;   /* 30 detents/rev → one trigger per click */
    };

    /* ── Matrix transform (68 switch keys + 1 encoder push = 69 total) ───── */

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <6>;   /* 5 matrix rows + 1 virtual row for encoder push */

        /* Row 3 omits COL14 and row 5 omits COL7 (physical gaps, PRD §3).
         * Row 6 (index 5) has one key: the encoder push button at RC(5,0). */
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
RC(5,0)
        >;
    };
};
