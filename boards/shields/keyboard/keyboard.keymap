#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer structure (index = declaration order in `keymap { }` below):
 *   0  default_layer — base QWERTY
 *   1  sym_layer     — pure symbol layer (Espanso triggers)  (hold ⊃/COL9, &mo 1)
 *   2  fn_layer      — F-keys, navigation, studio/typing    (hold f/COL10, &mo 2)
 *   3  device_layer   — BT management + Mac/PC mode switch  (conditional: ⊃+f held)
 *   4  esc_layer      — brightness/lock                     (hold Esc)
 *   5  mac_mods       — Mac-mode modifier overrides          (&tog 5, from
 *                        device_layer's `0` key)
 *   6  mac_lock_layer — Mac-specific lock shortcut override  (conditional:
 *                        esc_layer(4) + mac_mods(5) both active)
 *   7-9 extra1-3      — reserved for ZMK Studio expansion
 *
 * NOTE: extra1-3 shifted from indices 3-5 to 7-9 in this revision (device_layer,
 * esc_layer, mac_mods, mac_lock_layer were inserted before them). Any existing
 * ZMK Studio customizations on this board are keyed to the OLD indices — run
 * "Restore Stock Settings" in Studio after flashing before re-customizing.
 *
 * Symbols are NOT Unicode-macro'd by the firmware (REVISED — see git history:
 * the original urob/zmk-unicode approach needed macOS's Unicode Hex Input to be
 * the *active* input source, which was unworkable for a user with multiple input
 * sources typing symbols one at a time). Instead, sym_layer keys type a plain
 * ASCII trigger string (e.g. `;;pi`) via ordinary &kp taps, and a host-side text
 * expander (Espanso — https://espanso.org, identical config on macOS/Windows)
 * replaces it with the glyph. This makes symbol output fully OS-agnostic with no
 * firmware-side OS awareness needed at all — see each sym_* macro below and
 * README.md for the full trigger table and Espanso setup.
 *
 * Encoder (sensor index 0) — see keymap.c resolution: highest active layer with a
 * `sensor-bindings` entry wins; layers that omit it fall through to the next one
 * down while still active (e.g. device_layer omits it on purpose; see below).
 *   default      CW=Vol+       CCW=Vol-      push=&disp_cycle (next display mode)
 *   sym (⊃)      CW=next trk   CCW=prev trk  push=play/pause
 *   fn (f)       CW=scroll dn  CCW=scroll up push=middle-click
 *   device (⊃+f) — no sensor-bindings; rotation falls through to fn_layer's
 *                  scroll (harmless — same fallthrough philosophy as device_layer's
 *                  &trans key positions). push=&none
 *   esc (hold)   CW=brightness up  CCW=brightness down  push=lock screen
 *                (Win+L on PC; Ctrl+Cmd+Q on Mac — see mac_lock_layer)
 *
 * Esc key (base position 0, was &kp GRAVE):
 *   tap            → ESC
 *   shift+tap      → ` (GRAVE, via mod-morph)
 *   ⊃ held+tap     → ~ (LS(GRAVE), lives on sym_layer, not this behavior)
 *   hold           → esc_layer (brightness/lock)
 *
 * Row3/COL14 (was &kp DEL) → &caps_word. Delete lives on fn_layer + Backspace.
 * combo_sys_reset still targets key position 54 (now the Caps Word key) — combos
 * bind by physical position, not by what's currently bound there.
 *
 * Mac/PC modifier profile (mac_mods, layer 5): boot default is PC (layer 5 off).
 * device_layer `0` → &tog 5, a plain flip toggle — safe because it's the ONLY
 * binding involved (no Unicode mode to keep in sync anymore) and it only exists
 * on the momentary device layer, so it can never fire during normal typing
 * (mac_mods itself is &trans at that position, so `0` always types a zero
 * outside of holding ⊃+f). Right `<>` (COL11) deliberately stays Control in Mac
 * mode — see mac_mods layer comment below. */

/ {
    behaviors {
        /* Sensor-rotate behavior using &msc (mouse scroll) for the fn_layer. */
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };

        /* Display-mode cycle behavior (encoder push, default layer only). */
        disp_cycle: disp_cycle {
            compatible = "zmk,behavior-disp-cycle";
            #binding-cells = <0>;
            tapping-term-ms = <500>;
        };

        /* Typing-test toggle behavior (fn_layer, T). */
        typing_test_toggle: typing_test_toggle {
            compatible = "zmk,behavior-typing-test";
            #binding-cells = <0>;
        };

        /* Esc key: tap → ESC, shift+tap → GRAVE. Tap side of esc_ht below. */
        esc_morph: esc_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Esc key: hold → esc_layer (index 4). Tap → esc_morph above.
         * esc_morph takes 0 params; the tap-side param at the use site
         * (`&esc_ht 4 0`) is a required-but-unread dummy — verified against
         * behavior_hold_tap.c / behavior_mod_morph.c: mod-morph's parameter
         * metadata is explicitly empty (zmk_behavior_get_empty_param_metadata)
         * and its handler never reads binding->param1. */
        esc_ht: esc_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&esc_morph>;
            display-name = "Esc Hold-Tap";
        };

        /* sym_layer symbol macros — each types a plain ASCII Espanso trigger
         * (";;" + mnemonic), which a host-side Espanso match file (see
         * espanso/symbols.yml and README.md) expands into the actual glyph.
         * Naming convention: sym_<trigger-without-;;>. wait-ms/tap-ms start at
         * 5ms — Espanso has to see each individual keystroke to detect the
         * trigger, and firmware injection is much faster than human typing;
         * raise these (10-15) if triggers get missed in testing before
         * assuming anything else is wrong. Never wrap these in anything that
         * could apply Shift — a shifted trigger (e.g. "::PI") won't match and
         * will emit literal junk instead.
         *
         * Confirmed working end-to-end (both macOS and Windows/Espanso) as of
         * the commit that wired up the first 3 (sym_pi/sym_isin/sym_rt); all
         * 45 are now defined and wired into sym_layer below. */
        ZMK_MACRO(sym_pi, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp I>;)
        ZMK_MACRO(sym_isin, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp S &kp I &kp N>;)
        ZMK_MACRO(sym_rt, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp R &kp T>;)

        /* ── Greek letters ──────────────────────────────────────────── */
        ZMK_MACRO(sym_alpha, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp A &kp L &kp P &kp H &kp A>;)
        ZMK_MACRO(sym_beta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp B &kp E &kp T &kp A>;)
        ZMK_MACRO(sym_gamma, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp G &kp A &kp M &kp M &kp A>;)
        ZMK_MACRO(sym_delta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp D &kp E &kp L &kp T &kp A>;)
        ZMK_MACRO(sym_eps, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp E &kp P &kp S>;)
        ZMK_MACRO(sym_zeta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp Z &kp E &kp T &kp A>;)
        ZMK_MACRO(sym_eta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp E &kp T &kp A>;)
        ZMK_MACRO(sym_theta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp T &kp H &kp E &kp T &kp A>;)
        ZMK_MACRO(sym_iota, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp O &kp T &kp A>;)
        ZMK_MACRO(sym_kappa, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp K &kp A &kp P &kp P &kp A>;)
        ZMK_MACRO(sym_lambda, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp L &kp A &kp M &kp B &kp D &kp A>;)
        ZMK_MACRO(sym_mu, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp M &kp U>;)
        ZMK_MACRO(sym_nu, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp N &kp U>;)
        ZMK_MACRO(sym_rho, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp R &kp H &kp O>;)
        ZMK_MACRO(sym_sigma, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp S &kp I &kp G &kp M &kp A>;)
        ZMK_MACRO(sym_tau, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp T &kp A &kp U>;)
        ZMK_MACRO(sym_phi, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp H &kp I>;)
        ZMK_MACRO(sym_chi, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp C &kp H &kp I>;)
        ZMK_MACRO(sym_psi, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp S &kp I>;)
        ZMK_MACRO(sym_omega, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp O &kp M &kp E &kp G &kp A>;)

        /* ── Number row: math / logic ──────────────────────────────── */
        ZMK_MACRO(sym_pm, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp M>;)
        ZMK_MACRO(sym_sub, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp S &kp U &kp B>;)
        ZMK_MACRO(sym_yen, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp Y &kp E &kp N>;)
        ZMK_MACRO(sym_pd, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp D>;)
        ZMK_MACRO(sym_int, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp N &kp T>;)
        ZMK_MACRO(sym_nabla, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp N &kp A &kp B &kp L &kp A>;)
        ZMK_MACRO(sym_inf, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp N &kp F>;)
        ZMK_MACRO(sym_sqrt, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp S &kp Q &kp R &kp T>;)
        ZMK_MACRO(sym_deg, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp D &kp E &kp G>;)
        ZMK_MACRO(sym_ne, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp N &kp E>;)
        ZMK_MACRO(sym_approx, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp A &kp P &kp P &kp R &kp O &kp X>;)

        /* ── Brackets & punctuation ────────────────────────────────── */
        ZMK_MACRO(sym_fa, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp F &kp A>;)
        ZMK_MACRO(sym_te, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp T &kp E>;)
        ZMK_MACRO(sym_perp, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp E &kp R &kp P>;)
        ZMK_MACRO(sym_tf, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp T &kp F>;)
        ZMK_MACRO(sym_emd, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp E &kp M &kp D>;)
        ZMK_MACRO(sym_le, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp L &kp E>;)
        ZMK_MACRO(sym_ge, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp G &kp E>;)
        ZMK_MACRO(sym_irb, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp R &kp B>;)

        /* ── Arrows ────────────────────────────────────────────────── */
        ZMK_MACRO(sym_up, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp U &kp P>;)
        ZMK_MACRO(sym_dn, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp D &kp N>;)
        ZMK_MACRO(sym_lt, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp L &kp T>;)

    };

    /* Device layer (index 3) activates only while sym_layer (1) AND fn_layer (2)
     * are both held — i.e. ⊃+f together, neither alone.
     *
     * mac_lock_layer (index 6) activates only while esc_layer (4) AND
     * mac_mods (5) are both active — i.e. holding Esc while already toggled
     * into Mac mode. See esc_layer's and mac_lock_layer's comments below
     * for why the Mac-specific lock shortcut needs its own scoped layer
     * rather than living directly on mac_mods. */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        device_layer_cond {
            if-layers = <1 2>;
            then-layer = <3>;
        };
        mac_lock_cond {
            if-layers = <4 5>;
            then-layer = <6>;
        };
    };

    /* Safety combos.
     *
     * Key positions (0-based, from the matrix transform):
     *   LSHFT = 41  (Row 3 / COL1)
     *   RSHFT = 52  (Row 3 / COL12)
     *   BSPC  = 13  (Row 0 / COL14)
     *   POS54 = 54  (Row 3 / COL14 / MX55 — now &caps_word, was &kp DEL)
     *
     * combo_bootloader  — LSHFT + RSHFT + BSPC  → &bootloader (enter UF2 mode)
     * combo_sys_reset   — LSHFT + RSHFT + POS54 → &sys_reset  (soft reboot)
     *
     * Combos bind by physical position, not by current binding, so these still
     * work unchanged after POS54's binding changed to &caps_word.
     *
     * Three keys must all be pressed within 50 ms, making accidental
     * activation essentially impossible during normal typing. */
    combos {
        compatible = "zmk,combos";

        combo_bootloader {
            key-positions = <41 52 13>;
            bindings = <&bootloader>;
            timeout-ms = <50>;
        };

        combo_sys_reset {
            key-positions = <41 52 54>;
            bindings = <&sys_reset>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
/* ── Row 0: number row (COL0 = Esc/hold-tap, was &kp GRAVE) ─────────────────── */
&esc_ht 4 0 &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
/* ── Row 1: QWERTY ──────────────────────────────────────────────────────────── */
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSLH
/* ── Row 2: home row (13 keys; COL14 omitted — display cutout) ──────────────── */
&kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp APOS &kp RET
/* ── Row 3: bottom alpha (COL14/MX55 = &caps_word, was &kp DEL) ─────────────── */
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp UP &caps_word
/* ── Row 4: modifiers (13 keys; COL7 omitted — physical gap) ───────────────── *
 * COL1     COL2   COL3   COL4(MX59)  COL5        COL6                           *
 * <>/LCTRL ⊞/LGUI LALT   ⌘/LCTRL*    Space1(2u)  ✦/RALT  [gap]                  *
 *                  COL8        COL9   COL10  COL11(MX65)  COL12  COL13  COL14   *
 *                  Space2(2u)  ⊃/mo1  f/mo2  <>/LCTRL**   Left   Down   Right   *
 * * MX59 (⌘): was LGUI, now LCTRL — PC-correct base; mac_mods overrides to Cmd  *
 * **MX65 (right <>): was RCTRL, now LCTRL — mac_mods leaves it &trans (Ctrl)    */
&kp LCTRL &kp LGUI &kp LALT &kp LCTRL &kp SPACE &kp RALT &kp SPACE &mo 1 &mo 2 &kp LCTRL &kp LEFT &kp DOWN &kp RIGHT
/* ── Row 5: encoder push (RC(5,0)) — &disp_cycle ────────────────────────────── */
&disp_cycle
            >;
        };

        sym_layer {
            display-name = "SYMBOLS";
            /* Pure symbol layer (Espanso triggers — see behaviors block,
             * espanso/symbols.yml, and README.md). Nothing else lives here —
             * no F-keys, no BT actions. Q/S/C/J/M are deliberately &trans
             * (not a gap to fill — a prior design decision, do not invent
             * mappings). All 45 symbols confirmed working on real hardware. */
            sensor-bindings = <&inc_dec_kp C_PREV C_NEXT>;
            bindings = <
/* Row 0 — Esc→~; number row math/logic */
&kp LS(GRAVE) &sym_pm &sym_sub &sym_isin &sym_yen &sym_pd &sym_int &sym_nabla &sym_inf &sym_sqrt &sym_deg &sym_ne &sym_approx &trans
/* Row 1 — Greek W-P + brackets/backslash. Q unmapped (deliberate). */
&trans  &trans  &sym_omega  &sym_eps  &sym_rho  &sym_tau  &sym_psi  &sym_mu  &sym_iota  &sym_sigma  &sym_pi  &sym_fa  &sym_te  &sym_perp
/* Row 2 — Greek A,D,F,G,H,K,L + ∴/— ; S,J unmapped (deliberate). */
&trans  &sym_alpha  &trans  &sym_delta  &sym_phi  &sym_gamma  &sym_theta  &trans  &sym_kappa  &sym_lambda  &sym_tf  &sym_emd  &trans
/* Row 3 — Greek Z,X,V,B,N + ≤/≥/‽/↑ ; C,M unmapped (deliberate). */
&trans  &sym_zeta  &sym_chi  &trans  &sym_nu  &sym_beta  &sym_eta  &trans  &sym_le  &sym_ge  &sym_irb  &trans  &sym_up  &trans
/* Row 4 — arrows. Mod positions stay &trans. */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &sym_lt  &sym_dn  &sym_rt
/* Row 5 — encoder push: play/pause */
&kp C_PP
            >;
        };

        fn_layer {
            display-name = "FN";
            /* Hold f (COL10/mo2) to activate.
             *
             * Number row:  1-9 → F1-F9,  0 → F10,  - → F11,  = → F12,  Bksp → Del
             * Navigation:  Up → PgUp,  Left → Home,  Down → PgDn,  Right → End
             * RSHFT → &studio_unlock (hold f+RShift to unlock Studio)
             * T     → &typing_test_toggle                                      */
            sensor-bindings = <&inc_dec_msc SCRL_DOWN SCRL_UP>;
            bindings = <
/* Row 0 — number row: F1-F12 + Del */
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &kp DEL
/* Row 1 — T (index 5) = &typing_test_toggle; all others transparent */
&trans  &trans  &trans  &trans  &trans  &typing_test_toggle  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 2 — home row */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 3 — RSHFT (index 11) = &studio_unlock; UP → PgUp */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock  &kp PG_UP  &trans
/* Row 4 — arrows: Left → Home, Down → PgDn, Right → End */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp PG_DN  &kp END
/* Row 5 — encoder push: middle click */
&mkp MCLK
            >;
        };

        device_layer {
            display-name = "DEVICE";
            /* Conditional layer — active only while ⊃+f are BOTH held.
             *
             * Number row:
             *   1-5 → BT profile select 0-4       (wireless device switching)
             *   6   → BT clear current profile
             *   7   → BT_NXT  (cycle forward)
             *   8   → BT_PRV  (cycle backward)
             *   0   → &tog 5  — flip Mac/PC modifier profile (mac_mods). Plain
             *         flip is safe here: it's the only binding involved (no
             *         Unicode mode to keep in sync) and only reachable while
             *         holding ⊃+f, so it can never fire during normal typing.
             * Backslash → OUT_TOG  (toggle USB / BLE output)
             * All other keys transparent.
             *
             * Encoder rotation deliberately has no sensor-bindings here — BT
             * profile cycling via the encoder was dropped (easy to overshoot
             * and disconnect; the discrete 1-8 keys cover it). Rotation falls
             * through to fn_layer's scroll behavior, same fallthrough already
             * accepted for this layer's &trans key positions. */
            bindings = <
/* Row 0 — BT management + Mac/PC mode switch */
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR  &bt BT_NXT  &bt BT_PRV  &trans  &tog 5  &trans  &trans  &trans
/* Row 1 — backslash → OUT_TOG */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &out OUT_TOG
/* Row 2 — home row */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 3 */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 4 */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 5 — encoder push: no-op */
&none
            >;
        };

        esc_layer {
            display-name = "BRIGHT";
            /* Hold Esc to activate. Encoder only — all key positions &trans.
             *
             * Rotate: display brightness up/down (Consumer page — well
             * supported on macOS, frequently ignored by Windows for external
             * keyboards; that's a host-OS limitation, not a firmware bug).
             * Press: lock the screen. This is the PC default — &kp LG(L),
             * Win+L, the standard Windows lock shortcut. Mac mode needs a
             * DIFFERENT shortcut (Ctrl+Cmd+Q) — that override lives on the
             * mac_lock_layer conditional layer (index 6, active only while
             * BOTH esc_layer and mac_mods are simultaneously active), NOT
             * directly on mac_mods itself. Reason: unlike the Row4 modifier
             * positions mac_mods overrides unconditionally, row5 (encoder
             * push) has a different valid meaning on every other layer
             * (disp_cycle/play-pause/middle-click/none) — a plain override
             * on mac_mods here would silently break &disp_cycle whenever Mac
             * mode is toggled on, even without Esc held. See mac_lock_layer
             * below for the actual Mac binding. (Previously locked... er,
             * slept, via &mac_sleep — dropped in favor of locking per user
             * request.) */
            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LG(L)
            >;
        };

        mac_mods {
            display-name = "MAC MODE";
            /* Toggled by &tog 5 from device_layer's `0` key. &trans everywhere
             * except the 4 modifier positions below — never bind anything else
             * on this layer (including row5/encoder push — see mac_lock_layer
             * below for why that's a separate conditional layer instead), it
             * stays active during normal typing and would shadow the base
             * layer (or, for row5, &disp_cycle) for as long as Mac mode is on.
             *
             * Right `<>` (COL11) deliberately stays &trans (→ base LCTRL, i.e.
             * real Control) even in Mac mode: macOS genuinely needs a Control
             * key (Ctrl+C/SIGINT, Ctrl+Tab, Spaces switching, emacs bindings).
             * Left `<>` and `⌘` both send Cmd instead — do not "fix" this
             * asymmetry for consistency, it's the point. */
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LGUI  &kp LC(UP)  &trans  &kp LGUI  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans
            >;
        };

        mac_lock_layer {
            display-name = "MAC LOCK";
            /* Conditional layer (index 6) — active only while esc_layer(4)
             * AND mac_mods(5) are BOTH active, i.e. holding Esc while already
             * in Mac mode. All &trans except row5 (encoder push): Ctrl+Cmd+Q,
             * the current default macOS lock-screen shortcut (verified — see
             * commit message), overriding esc_layer's PC default (Win+L) only
             * in this exact scoped moment. See esc_layer's comment for why
             * this can't just live on mac_mods directly. */
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(LG(Q))
            >;
        };

        /* Reserved for ZMK Studio expansion. NOTE: shifted from indices 3-5 to
         * 7-9 in this revision — run "Restore Stock Settings" in Studio after
         * flashing before re-customizing (see keymap header comment). */
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
    };
};
