#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer structure (index = declaration order in `keymap { }` below):
 *   0  default_layer — base QWERTY
 *   1  sym_layer     — pure symbol layer (Espanso triggers)  (hold ⊃/COL9, &mo 1)
 *   2  fn_layer      — F-keys, navigation, studio/typing    (hold f/COL10, &mo 2)
 *   3  device_layer   — BT management + Mac/PC mode switch  (conditional: ⊃+f held)
 *   4  esc_layer      — brightness/lock                     (hold Esc)
 *   5  mac_mods       — Mac-mode modifier overrides          (&tog 5, from
 *                        device_layer's `0` key)
 *   6  mac_lock_layer — Mac-specific lock shortcut override  (conditional:
 *                        esc_layer(4) + mac_mods(5) both active)
 *   7-9 extra1-3      — reserved for ZMK Studio expansion
 *
 * NOTE: extra1-3 shifted from indices 3-5 to 7-9 in this revision (device_layer,
 * esc_layer, mac_mods, mac_lock_layer were inserted before them). Any existing
 * ZMK Studio customizations on this board are keyed to the OLD indices — run
 * "Restore Stock Settings" in Studio after flashing before re-customizing.
 *
 * Symbols are NOT Unicode-macro'd by the firmware (REVISED — see git history:
 * the original urob/zmk-unicode approach needed macOS's Unicode Hex Input to be
 * the *active* input source, which was unworkable for a user with multiple input
 * sources typing symbols one at a time). Instead, sym_layer keys type a plain
 * ASCII trigger string (e.g. `;;pi`) via ordinary &kp taps, and a host-side text
 * expander (Espanso — https://espanso.org, identical config on macOS/Windows)
 * replaces it with the glyph. This makes symbol output fully OS-agnostic with no
 * firmware-side OS awareness needed at all — see each sym_* macro below and
 * README.md for the full trigger table and Espanso setup.
 *
 * Encoder (sensor index 0) — see keymap.c resolution: highest active layer with a
 * `sensor-bindings` entry wins; layers that omit it fall through to the next one
 * down while still active (e.g. device_layer omits it on purpose; see below).
 *   default      CW=Vol+       CCW=Vol-      push=&disp_cycle (next display mode)
 *   sym (⊃)      CW=next trk   CCW=prev trk  push=play/pause
 *   fn (f)       CW=scroll dn  CCW=scroll up push=middle-click
 *   device (⊃+f) — no sensor-bindings; rotation falls through to fn_layer's
 *                  scroll (harmless — same fallthrough philosophy as device_layer's
 *                  &trans key positions). push=&none
 *   esc (hold)   CW=brightness up  CCW=brightness down  push=lock screen
 *                (Win+L on PC; Ctrl+Cmd+Q on Mac — see mac_lock_layer)
 *
 * Esc key (base position 0, was &kp GRAVE):
 *   tap            → ESC
 *   shift+tap      → ` (GRAVE, via mod-morph)
 *   ⊃ held+tap     → ~ (LS(GRAVE), lives on sym_layer, not this behavior)
 *   hold           → esc_layer (brightness/lock)
 *
 * Row3/COL14 (was &kp DEL) → &caps_word. Delete lives on fn_layer + Backspace.
 * combo_sys_reset still targets key position 54 (now the Caps Word key) — combos
 * bind by physical position, not by what's currently bound there.
 *
 * Mac/PC modifier profile (mac_mods, layer 5): boot default is PC (layer 5 off).
 * device_layer `0` → &tog 5, a plain flip toggle — safe because it's the ONLY
 * binding involved (no Unicode mode to keep in sync anymore) and it only exists
 * on the momentary device layer, so it can never fire during normal typing
 * (mac_mods itself is &trans at that position, so `0` always types a zero
 * outside of holding ⊃+f). Right `<>` (COL11) deliberately stays Control in Mac
 * mode — see mac_mods layer comment below. */

/ {
    behaviors {
        /* Sensor-rotate behavior using &msc (mouse scroll) for the fn_layer.
         *
         * REVISION: 32ms (my first attempt) fixed the "queue always cancels
         * before any tick runs" bug (see below) but was still nowhere near
         * enough — it produced literally zero visible scroll. Traced the
         * exact numbers via source (behavior_input_two_axis.c) rather than
         * guessing again: with SCRL_UP/SCRL_DOWN's default speed value
         * (ZMK_POINTING_DEFAULT_SCRL_VAL = 10, dt-bindings/zmk/pointing.h)
         * and &msc's trigger-period-ms (16ms, mouse_scroll.dtsi, unmodified
         * — this project doesn't override the stock &msc node) and
         * acceleration-exponent=0 (uniform speed), each 16ms tick computes
         * move = speed * trigger_period_ms / 1000 = 10*16/1000 = 0.16 — and
         * track_remainder() truncates to an integer HID delta each tick, so
         * a SINGLE tick never emits anything; the fractional 0.16 has to
         * accumulate across MULTIPLE ticks before crossing 1.0. Worked out
         * precisely: tick 7 (112ms of continuous "press") is the first tick
         * that ever emits a real unit; tick 13 (208ms) the second. 32ms only
         * covered ticks 1-2, both emitting exactly 0 — hence "zero movement,
         * ever," not "weak movement." tap-ms=220 covers both the 112ms and
         * 208ms thresholds with margin, giving ~2 real scroll units per
         * detent. This value trades off directly against real-time feel per
         * click; raise it for a stronger scroll per detent, lower it (not
         * below ~120ms) for a lighter one — but don't go below ~112ms or
         * you're back to the "nothing happens" case for slow/light turns. */
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            tap-ms = <220>;
            bindings = <&msc>, <&msc>;
        };

        /* Display-mode cycle behavior (encoder push, default layer only). */
        disp_cycle: disp_cycle {
            compatible = "zmk,behavior-disp-cycle";
            #binding-cells = <0>;
            tapping-term-ms = <500>;
        };

        /* Typing-test toggle behavior (fn_layer, T). */
        typing_test_toggle: typing_test_toggle {
            compatible = "zmk,behavior-typing-test";
            #binding-cells = <0>;
        };

        /* Esc key: tap → ESC, shift+tap → GRAVE. Tap side of esc_ht below. */
        esc_morph: esc_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Esc key: hold → esc_layer (index 4). Tap → esc_morph above.
         * esc_morph takes 0 params; the tap-side param at the use site
         * (`&esc_ht 4 0`) is a required-but-unread dummy — verified against
         * behavior_hold_tap.c / behavior_mod_morph.c: mod-morph's parameter
         * metadata is explicitly empty (zmk_behavior_get_empty_param_metadata)
         * and its handler never reads binding->param1. */
        esc_ht: esc_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&esc_morph>;
            display-name = "Esc Hold-Tap";
        };

        /* Suppresses Shift from the outgoing HID report between press and
         * release — see behaviors/behavior_shift_mask.c. Used inside all
         * 45 "_upper"/"_shift" macros below, invoked from &shift_branch
         * (behavior_shift_branch.c), not zmk,behavior-mod-morph — see the
         * "Uppercase Greek" comment below for why plain mod-morph doesn't
         * work here. */
        shift_mask: shift_mask {
            compatible = "zmk,behavior-shift-mask";
            #binding-cells = <0>;
        };

        /* sym_layer symbol macros — each types a plain ASCII Espanso trigger
         * (";;" + mnemonic), which a host-side Espanso match file (see
         * espanso/symbols.yml and README.md) expands into the actual glyph.
         * Naming convention: sym_<trigger-without-;;>. wait-ms/tap-ms start at
         * 5ms — Espanso has to see each individual keystroke to detect the
         * trigger, and firmware injection is much faster than human typing;
         * raise these (10-15) if triggers get missed in testing before
         * assuming anything else is wrong. Never wrap these in anything that
         * could apply Shift — a shifted trigger (e.g. "::PI") won't match and
         * will emit literal junk instead.
         *
         * Confirmed working end-to-end (both macOS and Windows/Espanso) as of
         * the commit that wired up the first 3 (sym_pi/sym_isin/sym_rt); all
         * 45 are now defined and wired into sym_layer below. */
        ZMK_MACRO(sym_pi, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp I>;)
        ZMK_MACRO(sym_isin, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp S &kp I &kp N>;)
        ZMK_MACRO(sym_rt, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp R &kp T>;)

        /* ── Greek letters ──────────────────────────────────────────── */
        ZMK_MACRO(sym_alpha, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp A &kp L &kp P &kp H &kp A>;)
        ZMK_MACRO(sym_beta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp B &kp E &kp T &kp A>;)
        ZMK_MACRO(sym_gamma, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp G &kp A &kp M &kp M &kp A>;)
        ZMK_MACRO(sym_delta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp D &kp E &kp L &kp T &kp A>;)
        ZMK_MACRO(sym_eps, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp E &kp P &kp S>;)
        ZMK_MACRO(sym_zeta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp Z &kp E &kp T &kp A>;)
        ZMK_MACRO(sym_eta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp E &kp T &kp A>;)
        ZMK_MACRO(sym_theta, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp T &kp H &kp E &kp T &kp A>;)
        ZMK_MACRO(sym_iota, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp O &kp T &kp A>;)
        ZMK_MACRO(sym_kappa, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp K &kp A &kp P &kp P &kp A>;)
        ZMK_MACRO(sym_lambda, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp L &kp A &kp M &kp B &kp D &kp A>;)
        ZMK_MACRO(sym_mu, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp M &kp U>;)
        ZMK_MACRO(sym_nu, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp N &kp U>;)
        ZMK_MACRO(sym_rho, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp R &kp H &kp O>;)
        ZMK_MACRO(sym_sigma, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp S &kp I &kp G &kp M &kp A>;)
        ZMK_MACRO(sym_tau, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp T &kp A &kp U>;)
        ZMK_MACRO(sym_phi, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp H &kp I>;)
        ZMK_MACRO(sym_chi, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp C &kp H &kp I>;)
        ZMK_MACRO(sym_psi, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp S &kp I>;)
        ZMK_MACRO(sym_omega, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp O &kp M &kp E &kp G &kp A>;)

        /* ── Uppercase Greek: ⊃ + Shift + letter ──────────────────────
         * Each Greek key position (in sym_layer, below) is wrapped in a
         * &shift_branch (behaviors/behavior_shift_branch.c) that picks
         * between the lowercase macro above and one of these "_upper"
         * macros when Shift is held.
         *
         * REVISION 1: originally used &shift_mask alone, invoked by a
         * plain zmk,behavior-mod-morph — broke the moment Shift was held
         * across MULTIPLE letters (the normal "hold shift, type several
         * capitals" gesture), because these macros' queued keystroke
         * sequences run asynchronously and can take longer to drain than
         * the physical letter key is held.
         *
         * REVISION 2: adding &shift_mask (invoked via &macro_press/
         * &macro_release inside each macro, scoped to that macro's own
         * start-to-finish window) was necessary but NOT sufficient —
         * mod-morph's own on_mod_morph_binding_released() ALSO
         * unconditionally calls zmk_hid_masked_modifiers_clear() tied to
         * the physical letter key's release. Both mechanisms write the
         * SAME global masked_modifiers variable (zmk/hid.c) — a flat
         * set/clear, not reference-counted — so mod-morph's own clear
         * could still fire in the middle of a macro's masked window and
         * wipe it out early, letting the tail of the trigger text go out
         * shifted again. Confirmed as the actual reason it kept breaking.
         *
         * FIX: &shift_branch is a mod-morph clone with the masking side
         * effect surgically removed — it does ONLY the branching
         * decision. &shift_mask (still invoked from inside each macro,
         * unchanged) is now the ONLY thing touching masked_modifiers, so
         * nothing competes with it. This doesn't touch real key-press
         * state (unlike explicitly injecting &kp LSHFT release/press), so
         * there's no risk of Shift getting "stuck" held if released
         * mid-macro — masking is a pure real-time filter that stops
         * applying the instant &shift_mask itself releases.
         *
         * Trigger text distinguishing: these still need their own
         * distinct trigger rather than relying on case, since masking
         * makes the actual keystrokes sent lowercase-shaped regardless of
         * Shift. ";;;" (3 semicolons, vs. 2 for lowercase) is the
         * distinguishing prefix. Verified: no 2-semi trigger is a prefix
         * of a 3-semi one (they diverge at the 3rd character - ';' vs a
         * letter - for every pair), and no 3-semi trigger is a prefix of
         * another for the same reason the lowercase set already isn't
         * (see espanso/symbols.yml). */
        ZMK_MACRO(sym_alpha_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp A &kp L &kp P &kp H &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_beta_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp B &kp E &kp T &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_gamma_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp G &kp A &kp M &kp M &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_delta_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp D &kp E &kp L &kp T &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_eps_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp E &kp P &kp S
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_zeta_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp Z &kp E &kp T &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_eta_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp E &kp T &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_theta_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp T &kp H &kp E &kp T &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_iota_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp I &kp O &kp T &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_kappa_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp K &kp A &kp P &kp P &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_lambda_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp L &kp A &kp M &kp B &kp D &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_mu_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp M &kp U
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_nu_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp N &kp U
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_pi_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp P &kp I
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_rho_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp R &kp H &kp O
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_sigma_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp S &kp I &kp G &kp M &kp A
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_tau_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp T &kp A &kp U
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_phi_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp P &kp H &kp I
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_chi_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp C &kp H &kp I
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_psi_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp P &kp S &kp I
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_omega_upper, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp O &kp M &kp E &kp G &kp A
                              &macro_release &shift_mask>;)

        sym_alpha_morph: sym_alpha_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_alpha>, <&sym_alpha_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_beta_morph: sym_beta_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_beta>, <&sym_beta_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_gamma_morph: sym_gamma_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_gamma>, <&sym_gamma_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_delta_morph: sym_delta_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_delta>, <&sym_delta_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_eps_morph: sym_eps_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_eps>, <&sym_eps_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_zeta_morph: sym_zeta_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_zeta>, <&sym_zeta_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_eta_morph: sym_eta_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_eta>, <&sym_eta_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_theta_morph: sym_theta_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_theta>, <&sym_theta_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_iota_morph: sym_iota_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_iota>, <&sym_iota_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_kappa_morph: sym_kappa_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_kappa>, <&sym_kappa_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_lambda_morph: sym_lambda_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_lambda>, <&sym_lambda_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_mu_morph: sym_mu_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_mu>, <&sym_mu_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_nu_morph: sym_nu_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_nu>, <&sym_nu_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_pi_morph: sym_pi_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_pi>, <&sym_pi_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_rho_morph: sym_rho_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_rho>, <&sym_rho_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_sigma_morph: sym_sigma_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_sigma>, <&sym_sigma_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_tau_morph: sym_tau_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_tau>, <&sym_tau_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_phi_morph: sym_phi_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_phi>, <&sym_phi_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_chi_morph: sym_chi_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_chi>, <&sym_chi_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_psi_morph: sym_psi_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_psi>, <&sym_psi_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_omega_morph: sym_omega_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_omega>, <&sym_omega_upper>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* ── Number row: math / logic ──────────────────────────────── */
        ZMK_MACRO(sym_pm, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp M>;)
        ZMK_MACRO(sym_sub, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp S &kp U &kp B>;)
        ZMK_MACRO(sym_yen, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp Y &kp E &kp N>;)
        ZMK_MACRO(sym_pd, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp D>;)
        ZMK_MACRO(sym_int, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp N &kp T>;)
        ZMK_MACRO(sym_nabla, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp N &kp A &kp B &kp L &kp A>;)
        ZMK_MACRO(sym_inf, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp N &kp F>;)
        ZMK_MACRO(sym_sqrt, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp S &kp Q &kp R &kp T>;)
        ZMK_MACRO(sym_deg, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp D &kp E &kp G>;)
        ZMK_MACRO(sym_ne, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp N &kp E>;)
        ZMK_MACRO(sym_approx, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp A &kp P &kp P &kp R &kp O &kp X>;)

        /* ── Brackets & punctuation ────────────────────────────────── */
        ZMK_MACRO(sym_fa, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp F &kp A>;)
        ZMK_MACRO(sym_te, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp T &kp E>;)
        ZMK_MACRO(sym_perp, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp P &kp E &kp R &kp P>;)
        ZMK_MACRO(sym_tf, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp T &kp F>;)
        ZMK_MACRO(sym_emd, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp E &kp M &kp D>;)
        ZMK_MACRO(sym_le, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp L &kp E>;)
        ZMK_MACRO(sym_ge, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp G &kp E>;)
        ZMK_MACRO(sym_irb, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp I &kp R &kp B>;)

        /* ── Arrows ────────────────────────────────────────────────── */
        ZMK_MACRO(sym_up, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp U &kp P>;)
        ZMK_MACRO(sym_dn, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp D &kp N>;)
        ZMK_MACRO(sym_lt, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&kp SEMI &kp SEMI &kp L &kp T>;)

        /* ── Shift variants for the remaining 24 symbols ──────────────
         * Same mechanism as uppercase Greek above: ⊃ + Shift + key gives
         * a second, related symbol via a &shift_branch + &shift_mask-wrapped
         * macro (see the "Uppercase Greek" comment above for why plain
         * mod-morph doesn't work for this). Naming here is "_shift" rather
         * than "_upper" since these
         * aren't case pairs of one glyph, just a second assigned symbol
         * per key. New symbols and mnemonics (mnemonic is unrelated to
         * the base key's own mnemonic on purpose, so it reads on its own
         * in espanso/symbols.yml):
         *   ± → ⇔ iff        ⊆ → ⊂ psub       ∈ → ∉ nisin      ¥ → € eur
         *   ∂ → ⨀ odot       ∫ → ∮ cint        ∇ → ⊗ otimes     ∞ → ∝ prop
         *   √ → ✓ check      ° → ∅ empty       ≠ → ¬ not        ≈ → ≡ equiv
         *   ∀ → ∧ and        ∃ → ∨ or          ⊥ → ∥ par        — → – endash
         *   ∴ → ∵ bcs        ≤ → ≪ ll          ≥ → ≫ gg         ‽ → ¿ iq
         *   ↑ → ∩ cap        → → ⇒ imp         ↓ → ∪ cup        ← → ⇐ bimp
         * NOTE on → and ←: as given, both were written mapping to the same
         * leftward double arrow (⇐) — almost certainly a copy/paste slip,
         * since ← already naturally pairs with ⇐. Implemented → as ⇒
         * (rightwards double arrow) instead, the consistent counterpart.
         * Flag if that's not what was meant. */
        ZMK_MACRO(sym_pm_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp I &kp F &kp F
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_sub_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp P &kp S &kp U &kp B
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_isin_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp N &kp I &kp S &kp I &kp N
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_yen_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp E &kp U &kp R
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_pd_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp O &kp D &kp O &kp T
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_int_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp C &kp I &kp N &kp T
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_nabla_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp O &kp T &kp I &kp M &kp E &kp S
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_inf_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp P &kp R &kp O &kp P
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_sqrt_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp C &kp H &kp E &kp C &kp K
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_deg_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp E &kp M &kp P &kp T &kp Y
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_ne_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp N &kp O &kp T
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_approx_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp E &kp Q &kp U &kp I &kp V
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_fa_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp A &kp N &kp D
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_te_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp O &kp R
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_perp_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp P &kp A &kp R
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_emd_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp E &kp N &kp D &kp A &kp S &kp H
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_tf_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp B &kp C &kp S
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_le_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp L &kp L
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_ge_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp G &kp G
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_irb_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp I &kp Q
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_up_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp C &kp A &kp P
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_rt_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp I &kp M &kp P
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_dn_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp C &kp U &kp P
                              &macro_release &shift_mask>;)
        ZMK_MACRO(sym_lt_shift, wait-ms = <5>; tap-ms = <5>;
                  bindings = <&macro_press &shift_mask
                              &macro_tap &kp SEMI &kp SEMI &kp SEMI &kp B &kp I &kp M &kp P
                              &macro_release &shift_mask>;)

        sym_pm_morph: sym_pm_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_pm>, <&sym_pm_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_sub_morph: sym_sub_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_sub>, <&sym_sub_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_isin_morph: sym_isin_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_isin>, <&sym_isin_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_yen_morph: sym_yen_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_yen>, <&sym_yen_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_pd_morph: sym_pd_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_pd>, <&sym_pd_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_int_morph: sym_int_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_int>, <&sym_int_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_nabla_morph: sym_nabla_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_nabla>, <&sym_nabla_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_inf_morph: sym_inf_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_inf>, <&sym_inf_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_sqrt_morph: sym_sqrt_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_sqrt>, <&sym_sqrt_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_deg_morph: sym_deg_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_deg>, <&sym_deg_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_ne_morph: sym_ne_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_ne>, <&sym_ne_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_approx_morph: sym_approx_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_approx>, <&sym_approx_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_fa_morph: sym_fa_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_fa>, <&sym_fa_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_te_morph: sym_te_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_te>, <&sym_te_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_perp_morph: sym_perp_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_perp>, <&sym_perp_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_emd_morph: sym_emd_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_emd>, <&sym_emd_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_tf_morph: sym_tf_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_tf>, <&sym_tf_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_le_morph: sym_le_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_le>, <&sym_le_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_ge_morph: sym_ge_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_ge>, <&sym_ge_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_irb_morph: sym_irb_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_irb>, <&sym_irb_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_up_morph: sym_up_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_up>, <&sym_up_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_rt_morph: sym_rt_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_rt>, <&sym_rt_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_dn_morph: sym_dn_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_dn>, <&sym_dn_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_lt_morph: sym_lt_morph {
            compatible = "zmk,behavior-shift-branch";
            #binding-cells = <0>;
            bindings = <&sym_lt>, <&sym_lt_shift>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Shift variant for Backspace: Backspace = normal backspace,
         * Shift+Backspace = forward Delete. Plain &kp mod-morph, no
         * Espanso/macro involved — see default_layer's Backspace position. */
        bspc_morph: bspc_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    /* Device layer (index 3) activates only while sym_layer (1) AND fn_layer (2)
     * are both held — i.e. ⊃+f together, neither alone.
     *
     * mac_lock_layer (index 6) activates only while esc_layer (4) AND
     * mac_mods (5) are both active — i.e. holding Esc while already toggled
     * into Mac mode. See esc_layer's and mac_lock_layer's comments below
     * for why the Mac-specific lock shortcut needs its own scoped layer
     * rather than living directly on mac_mods. */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        device_layer_cond {
            if-layers = <1 2>;
            then-layer = <3>;
        };
        mac_lock_cond {
            if-layers = <4 5>;
            then-layer = <6>;
        };
    };

    /* Safety combos.
     *
     * Key positions (0-based, from the matrix transform):
     *   LSHFT = 41  (Row 3 / COL1)
     *   RSHFT = 52  (Row 3 / COL12)
     *   BSPC  = 13  (Row 0 / COL14)
     *   POS54 = 54  (Row 3 / COL14 / MX55 — now &caps_word, was &kp DEL)
     *
     * combo_bootloader  — LSHFT + RSHFT + BSPC  → &bootloader (enter UF2 mode)
     * combo_sys_reset   — LSHFT + RSHFT + POS54 → &sys_reset  (soft reboot)
     *
     * Combos bind by physical position, not by current binding, so these still
     * work unchanged after POS54's binding changed to &caps_word.
     *
     * Three keys must all be pressed within 50 ms, making accidental
     * activation essentially impossible during normal typing. */
    combos {
        compatible = "zmk,combos";

        combo_bootloader {
            key-positions = <41 52 13>;
            bindings = <&bootloader>;
            timeout-ms = <50>;
        };

        combo_sys_reset {
            key-positions = <41 52 54>;
            bindings = <&sys_reset>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
/* ── Row 0: number row (COL0 = Esc/hold-tap, was &kp GRAVE; COL14 =
 * &bspc_morph, was &kp BSPC — Shift+Backspace now sends Delete) ───────────── */
&esc_ht 4 0 &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &bspc_morph
/* ── Row 1: QWERTY ──────────────────────────────────────────────────────────── */
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSLH
/* ── Row 2: home row (13 keys; COL14 omitted — display cutout) ──────────────── */
&kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp APOS &kp RET
/* ── Row 3: bottom alpha (COL14/MX55 = &caps_word, was &kp DEL) ─────────────── */
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp UP &caps_word
/* ── Row 4: modifiers (13 keys; COL7 omitted — physical gap) ───────────────── *
 * COL1     COL2   COL3   COL4(MX59)  COL5        COL6                           *
 * <>/LCTRL ⊞/LGUI LALT   ⌘/LCTRL*    Space1(2u)  ✦/RALT  [gap]                  *
 *                  COL8        COL9   COL10  COL11(MX65)  COL12  COL13  COL14   *
 *                  Space2(2u)  ⊃/mo1  f/mo2  <>/LCTRL**   Left   Down   Right   *
 * * MX59 (⌘): was LGUI, now LCTRL — PC-correct base; mac_mods overrides to Cmd  *
 * **MX65 (right <>): was RCTRL, now LCTRL — mac_mods leaves it &trans (Ctrl)    */
&kp LCTRL &kp LGUI &kp LALT &kp LCTRL &kp SPACE &kp RALT &kp SPACE &mo 1 &mo 2 &kp LCTRL &kp LEFT &kp DOWN &kp RIGHT
/* ── Row 5: encoder push (RC(5,0)) — &disp_cycle ────────────────────────────── */
&disp_cycle
            >;
        };

        sym_layer {
            display-name = "SYMBOLS";
            /* Pure symbol layer (Espanso triggers — see behaviors block,
             * espanso/symbols.yml, and README.md). Nothing else lives here —
             * no F-keys, no BT actions. Q/S/C/J/M are deliberately &trans
             * (not a gap to fill — a prior design decision, do not invent
             * mappings). All 45 symbols confirmed working on real hardware. */
            sensor-bindings = <&inc_dec_kp C_PREV C_NEXT>;
            bindings = <
/* Row 0 — Esc→~; number row math/logic. All _morph — see behaviors block
 * "Shift variants for the remaining 24 symbols". */
&kp LS(GRAVE) &sym_pm_morph &sym_sub_morph &sym_isin_morph &sym_yen_morph &sym_pd_morph &sym_int_morph &sym_nabla_morph &sym_inf_morph &sym_sqrt_morph &sym_deg_morph &sym_ne_morph &sym_approx_morph &trans
/* Row 1 — Greek W-P + brackets/backslash. Q unmapped (deliberate).
 * All _morph — plain tap = base symbol, Shift+tap = shift variant. */
&trans  &trans  &sym_omega_morph  &sym_eps_morph  &sym_rho_morph  &sym_tau_morph  &sym_psi_morph  &sym_mu_morph  &sym_iota_morph  &sym_sigma_morph  &sym_pi_morph  &sym_fa_morph  &sym_te_morph  &sym_perp_morph
/* Row 2 — Greek A,D,F,G,H,K,L + ∴/— ; S,J unmapped (deliberate). */
&trans  &sym_alpha_morph  &trans  &sym_delta_morph  &sym_phi_morph  &sym_gamma_morph  &sym_theta_morph  &trans  &sym_kappa_morph  &sym_lambda_morph  &sym_tf_morph  &sym_emd_morph  &trans
/* Row 3 — Greek Z,X,V,B,N + ≤/≥/‽/↑ ; C,M unmapped (deliberate). */
&trans  &sym_zeta_morph  &sym_chi_morph  &trans  &sym_nu_morph  &sym_beta_morph  &sym_eta_morph  &trans  &sym_le_morph  &sym_ge_morph  &sym_irb_morph  &trans  &sym_up_morph  &trans
/* Row 4 — arrows. Mod positions stay &trans. */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &sym_lt_morph  &sym_dn_morph  &sym_rt_morph
/* Row 5 — encoder push: play/pause */
&kp C_PP
            >;
        };

        fn_layer {
            display-name = "FN";
            /* Hold f (COL10/mo2) to activate.
             *
             * Number row:  1-9 → F1-F9,  0 → F10,  - → F11,  = → F12,  Bksp → Del
             * Navigation:  Up → PgUp,  Left → Home,  Down → PgDn,  Right → End
             * RSHFT → &studio_unlock (hold f+RShift to unlock Studio)
             * T     → &typing_test_toggle                                      */
            sensor-bindings = <&inc_dec_msc SCRL_DOWN SCRL_UP>;
            bindings = <
/* Row 0 — number row: F1-F12 + Del */
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &kp DEL
/* Row 1 — T (index 5) = &typing_test_toggle; all others transparent */
&trans  &trans  &trans  &trans  &trans  &typing_test_toggle  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 2 — home row */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 3 — RSHFT (index 11) = &studio_unlock; UP → PgUp */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock  &kp PG_UP  &trans
/* Row 4 — arrows: Left → Home, Down → PgDn, Right → End */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp PG_DN  &kp END
/* Row 5 — encoder push: middle click */
&mkp MCLK
            >;
        };

        device_layer {
            display-name = "DEVICE";
            /* Conditional layer — active only while ⊃+f are BOTH held.
             *
             * Number row:
             *   1-5 → BT profile select 0-4       (wireless device switching)
             *   6   → BT clear current profile
             *   7   → BT_NXT  (cycle forward)
             *   8   → BT_PRV  (cycle backward)
             *   0   → &tog 5  — flip Mac/PC modifier profile (mac_mods). Plain
             *         flip is safe here: it's the only binding involved (no
             *         Unicode mode to keep in sync) and only reachable while
             *         holding ⊃+f, so it can never fire during normal typing.
             * Backslash → OUT_TOG  (toggle USB / BLE output)
             * All other keys transparent.
             *
             * Encoder rotation deliberately has no sensor-bindings here — BT
             * profile cycling via the encoder was dropped (easy to overshoot
             * and disconnect; the discrete 1-8 keys cover it). Rotation falls
             * through to fn_layer's scroll behavior, same fallthrough already
             * accepted for this layer's &trans key positions. */
            bindings = <
/* Row 0 — BT management + Mac/PC mode switch */
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR  &bt BT_NXT  &bt BT_PRV  &trans  &tog 5  &trans  &trans  &trans
/* Row 1 — backslash → OUT_TOG */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &out OUT_TOG
/* Row 2 — home row */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 3 */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 4 */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 5 — encoder push: no-op */
&none
            >;
        };

        esc_layer {
            display-name = "BRIGHT";
            /* Hold Esc to activate. Encoder only — all key positions &trans.
             *
             * Rotate: display brightness up/down (Consumer page — well
             * supported on macOS, frequently ignored by Windows for external
             * keyboards; that's a host-OS limitation, not a firmware bug).
             * Press: lock the screen. This is the PC default — &kp LG(L),
             * Win+L, the standard Windows lock shortcut. Mac mode needs a
             * DIFFERENT shortcut (Ctrl+Cmd+Q) — that override lives on the
             * mac_lock_layer conditional layer (index 6, active only while
             * BOTH esc_layer and mac_mods are simultaneously active), NOT
             * directly on mac_mods itself. Reason: unlike the Row4 modifier
             * positions mac_mods overrides unconditionally, row5 (encoder
             * push) has a different valid meaning on every other layer
             * (disp_cycle/play-pause/middle-click/none) — a plain override
             * on mac_mods here would silently break &disp_cycle whenever Mac
             * mode is toggled on, even without Esc held. See mac_lock_layer
             * below for the actual Mac binding. (Previously locked... er,
             * slept, via &mac_sleep — dropped in favor of locking per user
             * request.) */
            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LG(L)
            >;
        };

        mac_mods {
            display-name = "MAC MODE";
            /* Toggled by &tog 5 from device_layer's `0` key. &trans everywhere
             * except the 4 modifier positions below — never bind anything else
             * on this layer (including row5/encoder push — see mac_lock_layer
             * below for why that's a separate conditional layer instead), it
             * stays active during normal typing and would shadow the base
             * layer (or, for row5, &disp_cycle) for as long as Mac mode is on.
             *
             * Right `<>` (COL11) deliberately stays &trans (→ base LCTRL, i.e.
             * real Control) even in Mac mode: macOS genuinely needs a Control
             * key (Ctrl+C/SIGINT, Ctrl+Tab, Spaces switching, emacs bindings).
             * Left `<>` and `⌘` both send Cmd instead — do not "fix" this
             * asymmetry for consistency, it's the point. */
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LGUI  &kp LC(UP)  &trans  &kp LGUI  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans
            >;
        };

        mac_lock_layer {
            display-name = "MAC LOCK";
            /* Conditional layer (index 6) — active only while esc_layer(4)
             * AND mac_mods(5) are BOTH active, i.e. holding Esc while already
             * in Mac mode. All &trans except row5 (encoder push): Ctrl+Cmd+Q,
             * the current default macOS lock-screen shortcut (verified — see
             * commit message), overriding esc_layer's PC default (Win+L) only
             * in this exact scoped moment. See esc_layer's comment for why
             * this can't just live on mac_mods directly. */
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LC(LG(Q))
            >;
        };

        /* Reserved for ZMK Studio expansion. NOTE: shifted from indices 3-5 to
         * 7-9 in this revision — run "Restore Stock Settings" in Studio after
         * flashing before re-customizing (see keymap header comment). */
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
    };
};
