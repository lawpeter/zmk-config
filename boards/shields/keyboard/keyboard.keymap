#include <behaviors.dtsi>
#include <behaviors/unicode.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer structure (index = declaration order in `keymap { }` below):
 *   0  default_layer — base QWERTY
 *   1  sym_layer     — pure Unicode/math symbol layer      (hold ⊃/COL9, &mo 1)
 *   2  fn_layer      — F-keys, navigation, studio/typing    (hold f/COL10, &mo 2)
 *   3  device_layer   — BT management + Mac/PC mode switch  (conditional: ⊃+f held)
 *   4  esc_layer      — brightness/sleep                    (hold Esc)
 *   5  mac_mods       — Mac-mode modifier overrides          (&layer_on/&layer_off 5,
 *                        fired from device_layer's `9`/`0` keys)
 *   6-8 extra1-3      — reserved for ZMK Studio expansion
 *
 * NOTE: extra1-3 shifted from indices 3-5 to 6-8 in this revision (device_layer,
 * esc_layer, mac_mods were inserted before them). Any existing ZMK Studio
 * customizations on this board are keyed to the OLD indices — run "Restore Stock
 * Settings" in Studio after flashing before re-customizing.
 *
 * Unicode symbols are emitted via the urob/zmk-unicode module (&uc behavior,
 * config/west.yml). PC mode targets Windows+WinCompose specifically (not Linux) —
 * &uc's mode is switched in lockstep with the Mac/PC modifier profile via the
 * mac_mode_enable/mac_mode_disable macros on device_layer's `9`/`0` keys.
 *
 * Encoder (sensor index 0) — see keymap.c resolution: highest active layer with a
 * `sensor-bindings` entry wins; layers that omit it fall through to the next one
 * down while still active (e.g. device_layer omits it on purpose; see below).
 *   default      CW=Vol+       CCW=Vol-      push=&disp_cycle (next display mode)
 *   sym (⊃)      CW=next trk   CCW=prev trk  push=play/pause
 *   fn (f)       CW=scroll dn  CCW=scroll up push=middle-click
 *   device (⊃+f) — no sensor-bindings; rotation falls through to fn_layer's
 *                  scroll (harmless — same fallthrough philosophy as device_layer's
 *                  &trans key positions). push=&none
 *   esc (hold)   CW=brightness up  CCW=brightness down  push=sleep
 *
 * Esc key (base position 0, was &kp GRAVE):
 *   tap            → ESC
 *   shift+tap      → ` (GRAVE, via mod-morph)
 *   ⊃ held+tap     → ~ (LS(GRAVE), lives on sym_layer, not this behavior)
 *   hold           → esc_layer (brightness/sleep)
 *
 * Row3/COL14 (was &kp DEL) → &caps_word. Delete lives on fn_layer + Backspace.
 * combo_sys_reset still targets key position 54 (now the Caps Word key) — combos
 * bind by physical position, not by what's currently bound there.
 *
 * Mac/PC modifier profile (mac_mods, layer 5): boot default is PC (layer 5 off).
 * device_layer `9` → Mac mode on (&layer_on 5 + Unicode → macOS). `0` → PC mode
 * (&layer_off 5 + Unicode → WinCompose). Both keys only exist on the momentary
 * device layer, so neither can ever shadow base-layer typing. Right `<>` (COL11)
 * deliberately stays Control in Mac mode — see mac_mods layer comment below. */

/ {
    behaviors {
        /* Sensor-rotate behavior using &msc (mouse scroll) for the fn_layer. */
        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };

        /* Display-mode cycle behavior (encoder push, default layer only). */
        disp_cycle: disp_cycle {
            compatible = "zmk,behavior-disp-cycle";
            #binding-cells = <0>;
            tapping-term-ms = <500>;
        };

        /* Typing-test toggle behavior (fn_layer, T). */
        typing_test_toggle: typing_test_toggle {
            compatible = "zmk,behavior-typing-test";
            #binding-cells = <0>;
        };

        /* Esc key: tap → ESC, shift+tap → GRAVE. Tap side of esc_ht below. */
        esc_morph: esc_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Esc key: hold → esc_layer (index 4). Tap → esc_morph above.
         * esc_morph takes 0 params; the tap-side param at the use site
         * (`&esc_ht 4 0`) is a required-but-unread dummy — verified against
         * behavior_hold_tap.c / behavior_mod_morph.c: mod-morph's parameter
         * metadata is explicitly empty (zmk_behavior_get_empty_param_metadata)
         * and its handler never reads binding->param1. */
        esc_ht: esc_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&esc_morph>;
            display-name = "Esc Hold-Tap";
        };

        /* Idempotent layer activate/deactivate (not flip) — used so the Mac/PC
         * mode switch is two explicit "set" keys instead of a single toggle
         * that could desync from the Unicode input mode. */
        layer_on: layer_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        /* Mac/PC mode switch — ties mac_mods (layer 5) and the Unicode input
         * mode together in one keypress. Live only on device_layer's `9`/`0`. */
        ZMK_MACRO(mac_mode_enable, bindings = <&layer_on 5 &uc UC_SET_MACOS>;)
        ZMK_MACRO(mac_mode_disable, bindings = <&layer_off 5 &uc UC_SET_WIN_COMPOSE>;)
    };

    /* PC mode targets Windows+WinCompose (see keymap header comment). WIN_COMPOSE
     * is already the module's own built-in default; set explicitly for clarity
     * and to match mac_mods' boot-default-off (PC) state. */
    &uc {
        default-mode = <UC_MODE_WIN_COMPOSE>;
        minimum-length = <4>;
    };

    /* Device layer (index 3) activates only while sym_layer (1) AND fn_layer (2)
     * are both held — i.e. ⊃+f together, neither alone. */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        device_layer_cond {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    /* Safety combos.
     *
     * Key positions (0-based, from the matrix transform):
     *   LSHFT = 41  (Row 3 / COL1)
     *   RSHFT = 52  (Row 3 / COL12)
     *   BSPC  = 13  (Row 0 / COL14)
     *   POS54 = 54  (Row 3 / COL14 / MX55 — now &caps_word, was &kp DEL)
     *
     * combo_bootloader  — LSHFT + RSHFT + BSPC  → &bootloader (enter UF2 mode)
     * combo_sys_reset   — LSHFT + RSHFT + POS54 → &sys_reset  (soft reboot)
     *
     * Combos bind by physical position, not by current binding, so these still
     * work unchanged after POS54's binding changed to &caps_word.
     *
     * Three keys must all be pressed within 50 ms, making accidental
     * activation essentially impossible during normal typing. */
    combos {
        compatible = "zmk,combos";

        combo_bootloader {
            key-positions = <41 52 13>;
            bindings = <&bootloader>;
            timeout-ms = <50>;
        };

        combo_sys_reset {
            key-positions = <41 52 54>;
            bindings = <&sys_reset>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
            bindings = <
/* ── Row 0: number row (COL0 = Esc/hold-tap, was &kp GRAVE) ─────────────────── */
&esc_ht 4 0 &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
/* ── Row 1: QWERTY ──────────────────────────────────────────────────────────── */
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSLH
/* ── Row 2: home row (13 keys; COL14 omitted — display cutout) ──────────────── */
&kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp APOS &kp RET
/* ── Row 3: bottom alpha (COL14/MX55 = &caps_word, was &kp DEL) ─────────────── */
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp UP &caps_word
/* ── Row 4: modifiers (13 keys; COL7 omitted — physical gap) ───────────────── *
 * COL1     COL2   COL3   COL4(MX59)  COL5        COL6                           *
 * <>/LCTRL ⊞/LGUI LALT   ⌘/LCTRL*    Space1(2u)  ✦/RALT  [gap]                  *
 *                  COL8        COL9   COL10  COL11(MX65)  COL12  COL13  COL14   *
 *                  Space2(2u)  ⊃/mo1  f/mo2  <>/LCTRL**   Left   Down   Right   *
 * * MX59 (⌘): was LGUI, now LCTRL — PC-correct base; mac_mods overrides to Cmd  *
 * **MX65 (right <>): was RCTRL, now LCTRL — mac_mods leaves it &trans (Ctrl)    */
&kp LCTRL &kp LGUI &kp LALT &kp LCTRL &kp SPACE &kp RALT &kp SPACE &mo 1 &mo 2 &kp LCTRL &kp LEFT &kp DOWN &kp RIGHT
/* ── Row 5: encoder push (RC(5,0)) — &disp_cycle ────────────────────────────── */
&disp_cycle
            >;
        };

        sym_layer {
            /* Pure Unicode/math symbol layer. Nothing else lives here — no
             * F-keys, no BT actions. Q/S/C/J/M are deliberately &trans (not a
             * gap to fill — a prior design decision, do not invent mappings).
             *
             * STAGED ROLLOUT (commit 1 of 2): only 3 validation symbols are
             * live below — π (P), ∈ (3), → (Right) — to confirm the Unicode
             * pipeline end-to-end (both Mac and PC/WinCompose mode) before the
             * remaining ~37 symbols are wired in a follow-up commit. Every
             * other symbol position is &trans for now (inert, not leaking old
             * F-key/BT bindings). */
            sensor-bindings = <&inc_dec_kp C_PREV C_NEXT>;
            bindings = <
/* Row 0 — Esc→~; number row math/logic (∈ on N3 is LIVE, rest pending) */
&kp LS(GRAVE) &trans &trans &uc 0x2208 0x0 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
/* Row 1 — Greek W-P; π on P is LIVE, rest pending. Q unmapped (deliberate). */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &uc 0x3C0 0x0  &trans  &trans  &trans
/* Row 2 — Greek A,D,F,G,H,K,L + ∴/— ; S,J unmapped (deliberate). Pending. */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 3 — Greek Z,X,V,B,N + ≤/≥/‽/↑ ; C,M unmapped (deliberate). Pending. */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 4 — arrows: → on Right is LIVE, ←/↓ pending. Mod positions stay &trans. */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &uc 0x2192 0x0
/* Row 5 — encoder push: play/pause */
&kp C_PP
            >;
        };

        fn_layer {
            /* Hold f (COL10/mo2) to activate.
             *
             * Number row:  1-9 → F1-F9,  0 → F10,  - → F11,  = → F12,  Bksp → Del
             * Navigation:  Up → PgUp,  Left → Home,  Down → PgDn,  Right → End
             * RSHFT → &studio_unlock (hold f+RShift to unlock Studio)
             * T     → &typing_test_toggle                                      */
            sensor-bindings = <&inc_dec_msc SCRL_DOWN SCRL_UP>;
            bindings = <
/* Row 0 — number row: F1-F12 + Del */
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &kp DEL
/* Row 1 — T (index 5) = &typing_test_toggle; all others transparent */
&trans  &trans  &trans  &trans  &trans  &typing_test_toggle  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 2 — home row */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 3 — RSHFT (index 11) = &studio_unlock; UP → PgUp */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock  &kp PG_UP  &trans
/* Row 4 — arrows: Left → Home, Down → PgDn, Right → End */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp PG_DN  &kp END
/* Row 5 — encoder push: middle click */
&mkp MCLK
            >;
        };

        device_layer {
            /* Conditional layer — active only while ⊃+f are BOTH held.
             *
             * Number row:
             *   1-5 → BT profile select 0-4       (wireless device switching)
             *   6   → BT clear current profile
             *   7   → BT_NXT  (cycle forward)
             *   8   → BT_PRV  (cycle backward)
             *   9   → Mac mode on  (mac_mode_enable: layer 5 on + Unicode→macOS)
             *   0   → PC mode on   (mac_mode_disable: layer 5 off + Unicode→WinCompose)
             * Backslash → OUT_TOG  (toggle USB / BLE output)
             * All other keys transparent.
             *
             * Encoder rotation deliberately has no sensor-bindings here — BT
             * profile cycling via the encoder was dropped (easy to overshoot
             * and disconnect; the discrete 1-8 keys cover it). Rotation falls
             * through to fn_layer's scroll behavior, same fallthrough already
             * accepted for this layer's &trans key positions. */
            bindings = <
/* Row 0 — BT management + Mac/PC mode switch */
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR  &bt BT_NXT  &bt BT_PRV  &mac_mode_enable  &mac_mode_disable  &trans  &trans  &trans
/* Row 1 — backslash → OUT_TOG */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &out OUT_TOG
/* Row 2 — home row */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 3 */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 4 */
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
/* Row 5 — encoder push: no-op */
&none
            >;
        };

        esc_layer {
            /* Hold Esc to activate. Encoder only — all key positions &trans.
             *
             * Rotate: display brightness up/down (Consumer page — well
             * supported on macOS, frequently ignored by Windows for external
             * keyboards; that's a host-OS limitation, not a firmware bug).
             * Press: system sleep, via &kp C_SLEEP (Consumer page "Sleep",
             * 0x32) rather than K_SLEEP — verified against hid.c: zmk_hid_press
             * only handles the Keyboard and Consumer HID pages, so K_SLEEP
             * (an unofficial reserved Keyboard-page usage) would silently do
             * nothing, while C_SLEEP is a real standardized usage. */
            sensor-bindings = <&inc_dec_kp C_BRI_DN C_BRI_UP>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp C_SLEEP
            >;
        };

        mac_mods {
            /* Activated by &layer_on 5 / deactivated by &layer_off 5 from
             * device_layer's `9`/`0` keys (mac_mode_enable/mac_mode_disable).
             * &trans everywhere except the 4 modifier positions below — never
             * bind anything else on this layer, it stays active during normal
             * typing and would shadow the base layer (see keymap header note
             * and the plan's "Corrections from review" #1).
             *
             * Right `<>` (COL11) deliberately stays &trans (→ base LCTRL, i.e.
             * real Control) even in Mac mode: macOS genuinely needs a Control
             * key (Ctrl+C/SIGINT, Ctrl+Tab, Spaces switching, emacs bindings).
             * Left `<>` and `⌘` both send Cmd instead — do not "fix" this
             * asymmetry for consistency, it's the point. */
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LGUI  &kp LC(UP)  &trans  &kp LGUI  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans
            >;
        };

        /* Reserved for ZMK Studio expansion. NOTE: shifted from indices 3-5 to
         * 6-8 in this revision — run "Restore Stock Settings" in Studio after
         * flashing before re-customizing (see keymap header comment). */
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
    };
};
